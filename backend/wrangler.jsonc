{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ad-interceptor-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",

  // The licence store. Create it with:
  //   npx wrangler d1 create ad-interceptor-licenses
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ad-interceptor-licenses",
      "database_id": "1ce6f390-10e7-43f7-930e-413bb53c1cff"
    }
  ],

  // Holds the pre-built Pro filter set that /v1/filters/latest serves.
  // Create it with:
  //   npx wrangler kv namespace create ad-interceptor-filters
  "kv_namespaces": [
    {
      "binding": "FILTERS",
      "id": "0fb85628078d4f5ebf6e4616cad4039a"
    }
  ],

  // Brute-forcing a 100-bit key is not a real threat; this exists to stop a
  // broken client or a bored person from burning the D1 read quota. period
  // must be exactly 10 or 60.
  "ratelimits": [
    {
      "name": "VALIDATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Prune activation records nobody has used in 60 days, so a customer who
  // reinstalls across machines is not permanently locked out by their own
  // history. Daily at 04:17 UTC.
  "triggers": {
    "crons": ["17 4 * * *"]
  },

  // Transactional email for licence-key delivery. Requires a domain onboarded
  // with `npx wrangler email sending enable <domain>` — a pages.dev subdomain
  // cannot be used, because SPF/DKIM records have to be added to DNS you own.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Sender address for key emails. Empty disables sending entirely (the Worker
  // records the key as undelivered rather than pretending). Set it to an
  // address on the onboarded domain.
  "vars": {
    "MAIL_FROM": "",
    "MAIL_FROM_NAME": "Ad Interceptor",
    "SUPPORT_EMAIL": "thenightwatchcaptain@gmail.com",

    // Who sold the licence, for the receipt email's footer. A legal statement,
    // not boilerplate: PayPal is a PROCESSOR, so the seller of record is the
    // individual named here and the tax obligation is theirs. Keep both in
    // step with legalName and processorName in store-listing/web/seller.json —
    // a receipt that contradicts the site is the copy the customer keeps.
    "SELLER_LEGAL_NAME": "Ratnesh Kushwaha",
    "PROCESSOR_NAME": "PayPal",

    // Which PayPal host to talk to. Anything other than "live" means sandbox,
    // deliberately: a typo should cost sandbox traffic, never real charges
    // against the wrong environment. Flip to "live" only once a sandbox
    // purchase has minted a real key end to end.
    "PAYPAL_ENV": "sandbox",

    // The billing plan /v1/checkout/paypal subscribes buyers to. Created by
    // scripts/paypal-setup.mjs, which prints it. Not a secret — a plan id is
    // public in a normal PayPal integration.
    //
    // MUST BE CHANGED IN THE SAME EDIT AS PAYPAL_ENV. Sandbox and live plan
    // ids are different objects in different accounts, so a live host with a
    // sandbox plan id fails every checkout — and the failure is a 503 the
    // buyer reads as "contact us", not something that shows up in testing.
    "PAYPAL_PLAN_ID": "P-71474011SD040523MNKWEWZI"
  },

  "observability": {
    "enabled": true
  }

  // Secrets — set with `npx wrangler secret put <NAME>`, never in this file.
  //
  // PayPal (the live provider since 2026-09-17):
  //   PAYPAL_CLIENT_ID       REST app client id
  //   PAYPAL_CLIENT_SECRET   REST app secret
  //   PAYPAL_WEBHOOK_ID      the id PayPal returns when you register the
  //                          webhook URL. Verification needs it; without it
  //                          every delivery is REJECTED, not accepted
  //                          unchecked — see verifyPayPalSignature.
  //   PAYPAL_WEBHOOK_ID_TEST optional second slot, so a sandbox app and a live
  //                          app can be configured at the same time
  //
  // Dodo (declined the account, route kept as the proven reference shape):
  //   DODO_WEBHOOK_SECRET        endpoint signing secret (whsec_...)
  //   DODO_WEBHOOK_SECRET_TEST   optional second slot
  //
  // Always:
  //   ADMIN_TOKEN            bearer token for /v1/admin/* (generate: openssl rand -hex 32)
}
