{
  "name": "ad-interceptor-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Licence and Pro filter API for Ad Interceptor (Cloudflare Worker)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute ad-interceptor-licenses --remote --file=schema.sql",
    "schema:local": "wrangler d1 execute ad-interceptor-licenses --local --config wrangler.local.jsonc --file=schema.sql",
    "tail": "wrangler tail",
    "dev:local": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "test:local": "node test/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
